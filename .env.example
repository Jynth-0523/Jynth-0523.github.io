# Export these in your shell before the optional historical health check.
# Values below are examples; use your own authorized archive and research copy.
RESEARCH_ASSETS_ROOT=/path/to/authorized/research-delivery
RESEARCH_ARCHIVE_DIR=/path/to/authorized/locked-run
LOCKED_RESEARCH_SOURCE=/path/to/authorized/locked-research/research.py
LOCKED_RESEARCH_TESTS=/path/to/authorized/locked-research/test_research.py
LOCKED_RESEARCH_BACKUP=/path/to/authorized/locked-research/original_backup.py
LOCKED_DATABASE_DUMP=/path/to/authorized/research_archive.dump
LOCKED_TABLEAU_WORKBOOK=/path/to/authorized/research_dashboard.twb
LOCKED_TABLEAU_PACKAGE=/path/to/authorized/research_dashboard.twbx
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=research_archive
PGSCHEMA=research
PGUSER=research_reader
# Authenticate using your local PostgreSQL setup. Do not put passwords here.
# Optional private development discovery integration; the browser workspace does not need it.
# DISCOVERY_ENGINE_ROOT=/path/to/hash-verified/discovery-engine
# PLATFORM_PYTHON=/path/to/python3
# ENABLE_LOCAL_DISCOVERY_API=1
