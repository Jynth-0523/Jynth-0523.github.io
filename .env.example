# Export these in your shell before the optional historical health check.
# Values below are examples; use your own authorized archive and research copy.
RESEARCH_ASSETS_ROOT=/path/to/authorized/v312-delivery
LOCKED_RESEARCH_ROOT=/path/to/authorized/v312-research
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=v312_research
PGUSER=research_reader
# Authenticate using your local PostgreSQL setup. Do not put passwords here.
# Optional private V8 integration; the browser workspace does not need it.
# DISCOVERY_ENGINE_ROOT=/path/to/hash-verified/v8-project
# PLATFORM_PYTHON=/path/to/python3
# ENABLE_LOCAL_DISCOVERY_API=1
